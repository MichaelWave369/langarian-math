{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelwave369.github.io/langarian-math/schemas/promotion-assessment.schema.json",
  "title": "Parallax Custody-Aware Promotion Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "assessment_type",
    "package",
    "policy",
    "evidence",
    "conformance",
    "custody",
    "status",
    "blockers",
    "warnings",
    "issued_at_utc",
    "claims_supported",
    "prohibited_inferences"
  ],
  "properties": {
    "schema_version": { "const": "promotion-assessment:v0.1" },
    "assessment_id": { "type": "string", "pattern": "^assessment:[0-9a-f]{64}$" },
    "assessment_type": { "const": "eligibility-review-not-package-mutation" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "current_maturity_level", "target_level"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "current_maturity_level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "target_level": { "const": 4 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schema_version": { "const": "promotion-policy:v0.1" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_locator", "suite_digest", "admissible_evidence_ids", "distinct_signer_ids"],
      "properties": {
        "suite_locator": { "type": "string", "minLength": 1 },
        "suite_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "admissible_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^evidence:[0-9a-f]{64}$" }
        },
        "distinct_signer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^signer:[0-9a-f]{64}$" }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_schema_version", "promotion_eligible", "operator_count", "blockers"],
      "properties": {
        "suite_schema_version": { "type": "string", "minLength": 1 },
        "promotion_eligible": { "type": "boolean" },
        "operator_count": { "type": "integer", "minimum": 0 },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_valid", "custody_ready", "admissible_evidence_count", "lifecycle_issue_count"],
      "properties": {
        "bundle_valid": { "type": "boolean" },
        "custody_ready": { "type": "boolean" },
        "admissible_evidence_count": { "type": "integer", "minimum": 0 },
        "lifecycle_issue_count": { "type": "integer", "minimum": 0 }
      }
    },
    "status": { "enum": ["ELIGIBLE_FOR_REVIEW", "BLOCKED"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "issued_at_utc": { "type": "string", "format": "date-time" },
    "claims_supported": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prohibited_inferences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
