{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelwave369.github.io/langarian-math/schemas/receipt-envelope.schema.json",
  "title": "Parallax Generic Receipt Envelope v0.2",
  "description": "Theory-neutral envelope binding a future execution to a declared theory package, operator contract, implementation, assumptions, checks, parents, and claim boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_schema_version", "theory_package", "operation_id", "operator_contract", "implementation", "inputs", "parameters", "outputs", "assumptions_used", "checks", "claims_supported", "claims_prohibited", "parent_receipts", "status", "timestamp_utc"],
  "properties": {
    "receipt_schema_version": { "const": "parallax-receipt-envelope:v0.2" },
    "theory_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schema_version": { "const": "theory-package:v0.2" }
      }
    },
    "operation_id": { "type": "string", "minLength": 1 },
    "operator_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "assumption_ids", "invariant_ids", "predicate_ids", "first_falsifier"],
      "properties": {
        "version": { "const": "operator-contract:v0.2" },
        "assumption_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "invariant_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "predicate_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "first_falsifier": { "type": "string", "minLength": 1 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "inputs": { "type": "array" },
    "parameters": { "type": "object" },
    "outputs": { "type": "array" },
    "assumptions_used": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate_id", "status"],
        "properties": {
          "predicate_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "WARN", "FAIL", "NOT_RUN"] },
          "observed": {},
          "expected": {}
        }
      }
    },
    "claims_supported": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "claims_prohibited": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "parent_receipts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["PASS", "WARN", "FAIL", "NOT_RUN"] },
    "timestamp_utc": { "type": "string", "minLength": 1 }
  }
}
