{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelwave369.github.io/langarian-math/schemas/repository-replay-ledger.schema.json",
  "title": "Repository Replay Ledger v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "metadata"],
  "properties": {
    "schema_version": { "const": "repository-replay-ledger:v0.1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "replay_key",
          "application_receipt_id",
          "release_receipt_id",
          "package_id",
          "action",
          "target_path",
          "base_commit",
          "mutation_commit",
          "application_branch",
          "consumed_at_utc",
          "merge_status"
        ],
        "properties": {
          "replay_key": { "$ref": "#/$defs/digest" },
          "application_receipt_id": { "type": "string", "pattern": "^repository-application:[0-9a-f]{64}$" },
          "release_receipt_id": { "type": "string", "pattern": "^release-receipt:[0-9a-f]{64}$" },
          "package_id": { "type": "string", "minLength": 1 },
          "action": { "enum": ["PROMOTION", "ROLLBACK"] },
          "target_path": { "type": "string", "minLength": 1 },
          "base_commit": { "$ref": "#/$defs/commit" },
          "mutation_commit": { "$ref": "#/$defs/commit" },
          "application_branch": { "type": "string", "pattern": "^controlled-release/" },
          "consumed_at_utc": { "type": "string", "format": "date-time" },
          "merge_status": { "const": "NOT_MERGED" }
        }
      },
      "uniqueItems": true
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}
