{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelwave369.github.io/langarian-math/schemas/repository-rollback-anchor.schema.json",
  "title": "Repository Rollback Anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "anchor_type",
    "status",
    "repository",
    "package",
    "target_path",
    "application_receipt_id",
    "release_receipt_id",
    "authority_decision_id",
    "action_applied",
    "application_base_commit",
    "mutation_commit",
    "application_head_commit",
    "merge_commit",
    "merged_manifest_hash",
    "restore_manifest_hash",
    "patch_digest",
    "replay_key",
    "established_at_utc",
    "claims_supported",
    "prohibited_inferences",
    "rollback_anchor_id"
  ],
  "properties": {
    "schema_version": { "const": "repository-rollback-anchor:v0.1" },
    "anchor_type": { "const": "exact-rollback-reference-not-rollback-authorization" },
    "status": { "const": "AVAILABLE_FOR_GOVERNED_ROLLBACK" },
    "repository": { "type": "string", "minLength": 3 },
    "package": { "type": "object" },
    "target_path": { "type": "string", "minLength": 1 },
    "application_receipt_id": { "$ref": "#/$defs/id" },
    "release_receipt_id": { "$ref": "#/$defs/id" },
    "authority_decision_id": { "$ref": "#/$defs/id" },
    "action_applied": { "enum": ["PROMOTION", "ROLLBACK"] },
    "application_base_commit": { "$ref": "#/$defs/commit" },
    "mutation_commit": { "$ref": "#/$defs/commit" },
    "application_head_commit": { "$ref": "#/$defs/commit" },
    "merge_commit": { "$ref": "#/$defs/commit" },
    "merged_manifest_hash": { "$ref": "#/$defs/hash" },
    "restore_manifest_hash": { "$ref": "#/$defs/hash" },
    "patch_digest": { "$ref": "#/$defs/hash" },
    "replay_key": { "$ref": "#/$defs/hash" },
    "established_at_utc": { "type": "string", "format": "date-time" },
    "claims_supported": { "type": "array", "items": { "type": "string" } },
    "prohibited_inferences": { "type": "array", "items": { "type": "string" } },
    "rollback_anchor_id": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[0-9a-f]{64}$" }
  }
}
